# no trailing slash: "node_modules/" matches directories only, so a node_modules
# *symlink* sailed past it and got committed in PR #71 — which replaced the real
# directory on pull and silently broke npx (a deploy staged and then died with no
# output). This form matches the symlink too.
node_modules
test-results/
playwright-report/
.playwright-mcp/
.deploy-stage/
.wrangler/
club/
league/
state/
og/

# gen_seo_pages.py rewrites these six in full on every deploy (deploy.sh runs it
# before it stages), and stamps today's date into each one. Tracking them meant
# every branch picked up a spurious diff the moment the data moved or the day
# rolled over — PR #92 changed js/data.js and left four of them stale in git,
# while production stayed correct because the deploy regenerates regardless.
# Same reasoning as club/ league/ state/ above: generated, so not committed.
# index.html, app.html and methodology.html are NOT here — those are
# hand-written pages the generator patches counts into, not files it owns.
about.html
faq.html
npsl-rankings.html
terms.html
upsl-rankings.html
us-soccer-pyramid.html
.venv/
crests/_svg_tmp/

# wrangler local secrets for the accounts endpoints (never commit)
.dev.vars
indexnow.json
